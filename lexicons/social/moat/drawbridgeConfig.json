{
  "lexicon": 1,
  "id": "social.moat.drawbridgeConfig",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "description": "User's Drawbridge configuration for real-time message delivery",
      "record": {
        "type": "object",
        "required": ["drawbridges"],
        "properties": {
          "drawbridges": {
            "type": "array",
            "description": "Ordered list of Drawbridge endpoints (highest priority first)",
            "maxLength": 5,
            "items": {
              "type": "ref",
              "ref": "#drawbridgeEntry"
            }
          }
        }
      }
    },
    "drawbridgeEntry": {
      "type": "object",
      "required": ["url", "priority"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "WebSocket URL of the Drawbridge (e.g. wss://drawbridge.moat.chat)"
        },
        "priority": {
          "type": "integer",
          "description": "Priority order (1 = highest)",
          "minimum": 1
        }
      }
    }
  }
}
