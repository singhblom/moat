<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only: allow plain http/ws so the app can reach a local
         Postern/Drawbridge dev server (e.g. via the emulator's 10.0.2.2) —
         see MOAT_PDS_URL/MOAT_DRAWBRIDGE_URL in lib/main.dart. Release
         builds (main/AndroidManifest.xml) do not get this. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
